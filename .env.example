# LATZ backend environment variables.
# Copy to .env for local development. In production (Render) set these in the
# service's Environment settings instead; never commit a real .env file.
# Every value below is a PLACEHOLDER. Replace it with your own.
#
# REQUIRED = the app will not start without it.
# OPTIONAL = has a safe default shown in the comment.

# ---------------------------------------------------------------- Environment
# OPTIONAL. "development" (default) or "production".
# production turns on strict startup checks: DEBUG must be false, CORS_ORIGINS
# must be set to https origins, DATABASE_URL must be PostgreSQL, and the AI
# provider key must be present (unless AI_ENABLED=false).
ENVIRONMENT=development

# REQUIRED. Display name and version (shown in the API docs).
PROJECT_NAME=LATZ API
VERSION=1.0.0

# OPTIONAL. Default false. Must be false in production (it logs all SQL).
DEBUG=false

# OPTIONAL. Defaults 0.0.0.0 and 8000. Hosting platforms usually inject PORT.
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------- Database
# REQUIRED. Local development example (use your own local database):
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/latz_dev
# Production must use a SEPARATE database from development. Supported URL
# schemes: postgresql:// and postgresql+psycopg2:// (nothing else is accepted
# in production). For Neon, copy the connection string from its dashboard,
# which already ends in ?sslmode=require. Include that suffix in the URL you use
# for Alembic migrations too: the settings below apply to the running API only.

# Connection pool (PostgreSQL only; all OPTIONAL, defaults shown).
# Connections per process = DB_POOL_SIZE + DB_MAX_OVERFLOW; multiply by the
# number of worker processes and keep the total under your database's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds before an idle pooled connection is replaced (serverless databases
# such as Neon close idle connections; dead ones are also detected by a ping
# before each use, which is always on).
DB_POOL_RECYCLE=300
# Seconds a request waits for a free pooled connection before failing.
DB_POOL_TIMEOUT=30
# Seconds allowed to open a new connection (a suspended Neon database needs a few
# seconds to wake up).
DB_CONNECT_TIMEOUT=10
# OPTIONAL. disable | allow | prefer | require | verify-ca | verify-full.
# Leave unset for the default: "require" in production, driver default otherwise.
# A sslmode already written in DATABASE_URL always wins.
# DB_SSLMODE=require

# ----------------------------------------------------------------------- Auth
# REQUIRED. At least 32 characters, random, never reused between environments.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value-of-at-least-32-characters
# OPTIONAL. Only HS256 is supported (default).
ALGORITHM=HS256
# REQUIRED. Token lifetime in minutes (1 to 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------ AI provider
# REQUIRED. Production supports "groq" only. "openai" is available for local development only.
AI_PROVIDER=groq
# REQUIRED. The model identifier for that provider (check the provider's current model list).
MODEL_NAME=replace-with-a-model-name-your-provider-offers
# Required in production for the provider you use (unless AI_ENABLED=false).
GROQ_API_KEY=
# Development-only and unused in the production deployment (production supports Groq only).
OPENAI_API_KEY=

# ----------------------------------------------------------------- Web / CORS
# OPTIONAL in development (default http://localhost:5173,http://127.0.0.1:5173).
# REQUIRED in production: comma-separated frontend origins, https only, no
# trailing path, no "*". Example: https://latz.pages.dev,https://latz.ai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OPTIONAL. Interactive API docs (/docs, /redoc, /openapi.json).
# Leave unset for the default: on in development, off in production.
# ENABLE_DOCS=false

# ------------------------------------------------------------ Feature switches
# OPTIONAL. Default true. Set false to close sign-ups without redeploying code.
# New registrations get HTTP 403; existing users can still sign in.
REGISTRATION_ENABLED=true
# OPTIONAL. Default true. Set false to switch off model-backed chat.
# May be true for local development. The production Render configuration keeps it
# false (render.yaml), so no model calls are made unless it is deliberately changed.
# /ai/chat and /ai/chat/stream then return HTTP 503; history and other pages keep working.
AI_ENABLED=true

# ------------------------------------------------------ Rate limits and AI quotas
# OPTIONAL. Defaults shown. Sized for a small shared free AI tier; tune later.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=10
AI_DAILY_REQUESTS_PER_USER=10
AI_DAILY_REQUESTS_GLOBAL=80
AI_DAILY_TOKENS_GLOBAL=150000
AI_MAX_CONCURRENT_STREAMS=3
# OPTIONAL. Default 0 = trust no proxy and use the direct peer address (safe).
# Number of trusted reverse-proxy hops in front of the app (0 to 5). Raise it only
# after verifying the real hop count of your host; a wrong value lets clients spoof
# their IP and weakens per-IP rate limits.
TRUSTED_PROXY_COUNT=0

# ------------------------------------------------------- Frontend (separate file)
# The frontend reads VITE_API_URL at build time (frontend/.env.production on Cloudflare Pages),
# for example VITE_API_URL=https://your-api.onrender.com . It is not read by the backend.
